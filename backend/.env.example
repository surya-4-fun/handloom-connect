PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=handloom_connect
DB_CONNECTION_LIMIT=10

# Security / JWT (MUST be set to a secure random string; no hardcoded fallback is permitted)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (comma-separated; CORS_ORIGINS or FRONTEND_URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# AI Wear Preview Provider Configuration (Server-Side Only)
AI_PREVIEW_MODE=mock
AI_PROVIDER=mock
AI_API_KEY=

# FastAPI Integration
FASTAPI_SERVICE_URL=http://localhost:8000

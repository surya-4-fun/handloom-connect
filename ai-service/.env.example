# AI Provider Configuration
# Supported providers: mock, openrouter, openai
AI_PROVIDER=openrouter
AI_API_KEY=your_openrouter_api_key_here
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
AI_BASE_URL=https://openrouter.ai/api/v1

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Allowed Browser Origins for FastAPI (comma-separated; leave empty in production if purely internal backend)
AI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

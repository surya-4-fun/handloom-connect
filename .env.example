# Handloom Connect - Environment Variables Template
# Copy this file to frontend/.env or frontend/.env.local

# Supabase Configuration (Frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Edge Function Secrets (Server-Side Only - Set via Supabase CLI or Dashboard)
# NEVER expose this key to the frontend or commit actual values
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-20b
